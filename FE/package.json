    "install:safe:win": "powershell -ExecutionPolicy Bypass -File install-deps.ps1",
    "clean": "rm -rf node_modules package-lock.json && npm cache clean --force",
    "clean:win": "powershell -Command \"if (Test-Path node_modules) { Remove-Item -Recurse -Force node_modules }; if (Test-Path package-lock.json) { Remove-Item -Force package-lock.json }; npm cache clean --force\""
