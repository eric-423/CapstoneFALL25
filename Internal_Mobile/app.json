{
  "expo": {
    "name": "Nội bộ TamTech",
    "slug": "TamTech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "scheme": "TamTech",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyBPv_hgheK6NvxXYLVy1dw1pJyCZMe_ZWM"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần quyền truy cập vị trí để hiển thị bản đồ",
        "NSLocationAlwaysUsageDescription": "Ứng dụng cần quyền truy cập vị trí để hiển thị bản đồ"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBPv_hgheK6NvxXYLVy1dw1pJyCZMe_ZWM"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.TamTech"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ứng dụng cần quyền truy cập vị trí để hiển thị bản đồ"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "fonts": [
      {
        "asset": "./src/assets/fonts/Montserrat-Regular.ttf",
        "family": "Montserrat-Regular"
      },
      {
        "asset": "./src/assets/fonts/Montserrat-Medium.ttf",
        "family": "Montserrat-Medium"
      },
      {
        "asset": "./src/assets/fonts/Montserrat-SemiBold.ttf",
        "family": "Montserrat-SemiBold"
      },
      {
        "asset": "./src/assets/fonts/Montserrat-Bold.ttf",
        "family": "Montserrat-Bold"
      }
    ]
  }
}
